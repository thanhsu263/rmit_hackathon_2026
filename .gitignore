# dependencies and build output
node_modules/
.next/
out/
dist/
build/

# secrets and local config - never commit
.env
.env.*
!.env.example
*.pem
*.key

# TideCloak dev container data (H2 database etc.)
*.mv.db
*.trace.db
h2/
tidecloak-data/

# TideCloak adapter JSON - exported per machine from tide-console, never committed.
# This repository goes public for the submission, so a leak here is permanent.
tidecloak.json

# logs, editor and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json

# Custodian Vault mock-mode state (simulated roles, approvals, key)
.mock-data/

# Third-party agent skills (kept local, not part of the submission)
.agents/
skills-lock.json

# Demo video working files: only demo/demo.mp4 (and demo.srt) belong in the repo
demo/raw.mp4
demo/frame_*.png

# Auto-generated by `next dev` for coding agents; not part of the submission
app/AGENTS.md

# Root wrapper has no dependencies; its lockfile is meaningless
/package-lock.json
